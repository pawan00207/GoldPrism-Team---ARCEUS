// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MarketSnapshot {
  id        String   @id @default(cuid())
  bucketAt  DateTime @unique @map("bucket_at") @db.Timestamptz(3)
  asOf      DateTime @map("as_of") @db.Timestamptz(3)
  status    String
  payload   Json     @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([asOf])
  @@map("market_snapshots")
}

model IngestionRun {
  id         String   @id @default(cuid())
  tradeDate  DateTime @map("trade_date") @db.Date
  fetchedAt  DateTime? @map("fetched_at") @db.Timestamptz(3)
  source     String
  status     String
  dataHealth Json     @map("data_health") @db.JsonB
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  @@unique([tradeDate, source])
  @@index([receivedAt])
  @@map("ingestion_runs")
}

model CostModelReviewState {
  id             String    @id
  needsReview    Boolean   @default(false) @map("needs_review")
  lastVerifiedAt DateTime? @map("last_verified_at") @db.Timestamptz(3)
  lastChangedAt  DateTime? @map("last_changed_at") @db.Timestamptz(3)
  lastSummary    String?   @map("last_summary")
  lastMonitorId  String?   @map("last_monitor_id")
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("cost_model_review_state")
}

model CostModelReviewEvent {
  id         String   @id
  monitorId  String   @map("monitor_id")
  outcome    String
  isRelevant Boolean? @map("is_relevant")
  summary    String?
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(3)
  payload    Json     @db.JsonB

  @@index([monitorId, receivedAt])
  @@map("cost_model_review_events")
}

model SourceLog {
  id           String   @id @default(cuid())
  tsIst        DateTime @map("ts_ist") @db.Timestamptz(3)
  sourceName   String   @map("source_name")
  method       String
  url          String
  status       String
  latencyMs    Int      @map("latency_ms")
  rowsReturned Int      @default(0) @map("rows_returned")
  note         String?

  @@index([sourceName, tsIst])
  @@map("source_log")
}

model CrossCheck {
  id          String   @id @default(cuid())
  tradeDate   DateTime @map("trade_date") @db.Date
  symbol      String
  expiry      DateTime @map("expiry") @db.Date
  settleA     Float    @map("settle_a")
  settleB     Float?   @map("settle_b")
  diffBps     Float?   @map("diff_bps")
  state       String
  sourceBUrl  String?  @map("source_b_url")
  checkedAtIst DateTime @map("checked_at_ist") @db.Timestamptz(3)

  @@unique([tradeDate, symbol, expiry])
  @@index([tradeDate, checkedAtIst])
  @@map("cross_check")
}
